{
  "name": "electron-calendar",
  "productName": "Electron Calendar",
  "description": "Ein lokaler, sicherer Desktop-Kalender mit optionalem KI-Assistenten",
  "version": "2.1.0",
  "private": true,
  "author": "SimHub <simhub.dev@gmail.com>",
  "copyright": "simon lackmann",
  "contributors": [
    "louisefindlay23 <louise@louisefindlay.com> (https://louisefindlay.com)"
  ],
  "license": "MIT",
  "homepage": "https://github.com/SimHub/simhub-electron-calendar",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "check": "node scripts/check.cjs",
    "pack": "electron-builder --dir",
    "release": "electron-builder --publish never",
    "agent": "node desktop/agent.cjs",
    "test:desktop": "node test/electron.e2e.cjs",
    "icons": "electron scripts/generate-icons.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.simhub.calendar",
    "asar": true,
    "files": [
      "desktop/**/*",
      "ui/**/*",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "buildResources": "resources"
    },
    "publish": null,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Office",
      "target": [
        "AppImage"
      ]
    },
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ]
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.4"
  }
}
